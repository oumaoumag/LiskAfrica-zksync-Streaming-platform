{
  "name": "lisk-africa-zksync-streaming",
  "version": "1.0.0",
  "description": "Music streaming platform on Lisk and zkSync",
  "private": true,
  "author": "Matter Labs",
  "license": "MIT",
  "repository": "https://github.com/matter-labs/zksync-hardhat-template.git",
  "scripts": {
    "deploy": "hardhat deploy-zksync --script deploy.ts",
    "deploy:lisk": "hardhat run deploy/deploy-lisk.ts --network liskSepolia",
    "deploy:optimism": "hardhat run deploy/deploy-lisk.ts --network optimismSepolia",
    "interact": "hardhat deploy-zksync --script interact.ts",
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test --network hardhat"
  },
  "dependencies": {
    "@matterlabs/hardhat-zksync-deploy": "^0.7.0",
    "@matterlabs/hardhat-zksync-solc": "^0.4.2",
    "@matterlabs/hardhat-zksync-verify": "^0.2.0",
    "@matterlabs/zksync-contracts": "^0.6.1",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^4.9.0",
    "dotenv": "^16.0.3",
    "ethers": "^5.7.2",
    "hardhat": "^2.19.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "zksync-web3": "^0.14.3"
  },
  "devDependencies": {
    "@matterlabs/hardhat-zksync": "^1.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.2.5",
    "chai": "^4.3.7",
    "mocha": "^10.2.0"
  }
}
